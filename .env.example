# WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_APP_SECRET=your_app_secret

# Your WhatsApp number (with country code, no + or spaces)
RECIPIENT_PHONE_NUMBER=1234567890

# Webhook verification (choose any random string)
WEBHOOK_VERIFY_TOKEN=my_secret_verify_token

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: CA certificate for SSL verification
DATABASE_CA_CERT=

# Journal page auth token (generate a random string)
JOURNAL_AUTH_TOKEN=your_random_auth_token

# Server
PORT=3000

# Comma-separated times in HH:MM format (24h)
JOURNAL_PROMPT_TIMES=09:00,21:00
