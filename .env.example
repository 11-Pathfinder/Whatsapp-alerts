# WhatsApp Cloud API (from Meta Developer Dashboard)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_TEMPLATE_NAME=your_approved_template_name

# Your personal WhatsApp number (with country code, no + or spaces)
RECIPIENT_PHONE_NUMBER=1234567890

# Webhook verification (choose any random string)
WEBHOOK_VERIFY_TOKEN=my_secret_verify_token

# Server
PORT=3000

# Comma-separated times in HH:MM format (24h)
JOURNAL_PROMPT_TIMES=09:00,21:00
